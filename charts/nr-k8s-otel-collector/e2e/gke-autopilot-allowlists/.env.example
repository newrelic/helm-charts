# Copy to `.env` (gitignored) or just let run-gke-autopilot-e2e.sh prompt and offer to save it.
# The runner resolves each value from: environment -> this .env -> interactive prompt.

# Existing GKE Autopilot cluster context. The runner never switches context; it only verifies this.
KUBE_CONTEXT=gke_k8s-o11y-team_us-west2_gke-autopilot-truong

# New Relic backend: US | EU | Staging | Local. Must match the account + keys below. GKE Autopilot
# testing uses a PRODUCTION account (Autopilot is not available on staging), so this is normally US.
REGION=US

# New Relic account. ALL THREE must belong to the SAME account + REGION: ACCOUNT_ID + USER API key
# drive the NRDB assertions; INGEST license key is what the deployed collector reports with.
ACCOUNT_ID=
API_KEY=
LICENSE_KEY=

# Optional: test a dev nrdot-collector image you built and pushed yourself. Leave unset to use the
# published newrelic/nrdot-collector. The runner adds --set images.collector.registry/tag.
COLLECTOR_REGISTRY=
COLLECTOR_TAG=
