{
  "extends": [
    "github>newrelic/k8s-agents-automation:renovate-base.json5"
  ],
  "bumpVersion": "patch",
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["charts/agent-control-bootstrap/Chart.yaml"],
      "datasourceTemplate": "helm",
      "registryUrlTemplate": "https://helm-charts.newrelic.com",
      "matchStrings": [
        "# renovate: chartName=(?<depName>\\S+)\\n[^:]+: (?<currentValue>\\S+)"
      ]
    },
    {
      // Keep appVersion in sync with the newrelic/nrdot-collector image tag for the
      // database NRDOT charts, since Renovate's default helm-values manager only
      // bumps image.tag in values.yaml and doesn't touch Chart.yaml's appVersion.
      "customType": "regex",
      "fileMatch": [
        "charts/mssql-otel/Chart.yaml",
        "charts/mysql-otel/Chart.yaml",
        "charts/postgresql-otel/Chart.yaml",
        "charts/oracle-otel/Chart.yaml"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "newrelic/nrdot-collector",
      "matchStrings": [
        "appVersion:\\s*[\"']?(?<currentValue>[^\"'\\n]+)[\"']?"
      ]
    }
  ],
  "packageRules": [
    // This is a shared repository where it is not clear that generic rules apply
    // Making rules per folders or properties runs the risk that future 
    // projects get accidentally automerged because they are not covered in old presets
    {
      "matchUpdateTypes": ["major", "minor", "patch", "pin", "digest", "pinDigest"],
      "automerge": false
    },
    {
      // Group all nri-bundle dependencies together in a single PR.
      "matchFileNames": [
        "charts/nri-bundle/**"
      ],
      "groupName": "Bundle dependencies",
      "groupSlug": "nri-bundle-dependencies"
    },
    {
      // Disable updates of Kube State Metrics.
      // See comments in ../charts/nri-bundle/Chart.yaml for details.
      "matchPackageNames": [
        "kube-state-metrics"
      ],
      "enabled": false
    },
    {
      // Disable updates in nri-bundle-legacy chart.
      "matchFileNames": [
        "charts/nri-bundle-legacy/**"
      ],
      "enabled": false
    },
    {
      // Enable updates of nri-kubernetes v2 in the legacy chart.
      "matchPackageNames": [
        "newrelic-infrastructure"
      ],
      "matchFileNames": [
        "charts/nri-bundle-legacy/**"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "enabled": true
    },
    {
      // Disable Flux for now.
      "matchPackageNames": [
        "flux",
        "flux2",
      ],
      "enabled": false
    },
    {
      // Auto-bump chart version when Renovate updates chart values files. These updates
      // are usually container tag updates.
      "matchFileNames": ["charts/*/values.yaml", "charts/*/Chart.yaml"],
      "bumpVersions": [
        {
          "filePatterns": ["{{packageFileDir}}/Chart.{yaml,yml}"],
          "matchStrings": ["version:\\s(?<version>[^\\s]+)"],
          "bumpType": "patch"
        }
      ]
    },
    {
      "matchFileNames": ["charts/agent-control-deployment/**"],
      "groupName": "agent-control-deployment dependencies",
      "groupSlug": "agent-control-deployment-dependencies"
    },
    {
      "matchFileNames": ["charts/agent-control-bootstrap/**"],
      "groupName": "agent-control-bootstrap dependencies",
      "groupSlug": "agent-control-bootstrap-dependencies"
    },
    {
      // Group nrdot-collector image bumps (and the appVersion sync above) across all
      // four database NRDOT charts into a single PR instead of one per chart.
      "matchPackageNames": ["newrelic/nrdot-collector"],
      "matchFileNames": [
        "charts/mssql-otel/**",
        "charts/mysql-otel/**",
        "charts/postgresql-otel/**",
        "charts/oracle-otel/**"
      ],
      "groupName": "nrdot-collector database charts",
      "groupSlug": "nrdot-collector-database-charts"
    }
  ]
}
