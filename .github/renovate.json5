{
  extends: [
    'github>newrelic/k8s-agents-automation:renovate-base.json5',
  ],
  bumpVersion: 'patch',
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '/charts/agent-control-bootstrap/Chart.yaml/',
      ],
      datasourceTemplate: 'helm',
      registryUrlTemplate: 'https://helm-charts.newrelic.com',
      matchStrings: [
        '# renovate: chartName=(?<depName>\\S+)\\n[^:]+: (?<currentValue>\\S+)',
      ],
    },
  ],
  packageRules: [
    {
      matchUpdateTypes: [
        'major',
        'minor',
        'patch',
        'pin',
        'digest',
        'pinDigest',
      ],
      automerge: false,
    },
    {
      matchFileNames: [
        'charts/nri-bundle/**',
      ],
      groupName: 'Bundle dependencies',
      groupSlug: 'nri-bundle-dependencies',
    },
    {
      matchPackageNames: [
        'kube-state-metrics',
      ],
      enabled: false,
    },
    {
      matchFileNames: [
        'charts/nri-bundle-legacy/**',
      ],
      enabled: false,
    },
    {
      matchPackageNames: [
        'newrelic-infrastructure',
      ],
      matchFileNames: [
        'charts/nri-bundle-legacy/**',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
      enabled: true,
    },
    {
      matchPackageNames: [
        'flux',
        'flux2',
      ],
      enabled: false,
    },
    {
      matchFileNames: [
        'charts/*/values.yaml',
        'charts/*/Chart.yaml',
      ],
      bumpVersions: [
        {
          filePatterns: [
            '{{packageFileDir}}/Chart.{yaml,yml}',
          ],
          matchStrings: [
            'version:\\s(?<version>[^\\s]+)',
          ],
          bumpType: 'patch',
        },
      ],
    },
    {
      matchFileNames: [
        'charts/agent-control-deployment/**',
      ],
      groupName: 'agent-control-deployment dependencies',
      groupSlug: 'agent-control-deployment-dependencies',
    },
    {
      matchFileNames: [
        'charts/agent-control-bootstrap/**',
      ],
      groupName: 'agent-control-bootstrap dependencies',
      groupSlug: 'agent-control-bootstrap-dependencies',
    },
  ],
}
